AUTH self-login

TEST "Create a project and save its first suite"
 ID self-create-project-file
 STEPS
  navigate to "/projects"
  wait for "New project" to appear
  click "New project"
  type "Self test {{AXTEST_CASE}}" in "Project name"
  type "http://localhost:5173" in "Production URL"
  type "Disposable project created by the axtest self-test suite" in "Description"
  click "Create Project"
  wait for "Self test {{AXTEST_CASE}}" to appear
 ASSERT
  assert "Self test {{AXTEST_CASE}}" is_visible
 STEPS
  click "Self test {{AXTEST_CASE}}"
  wait for "Configuration" to appear
  wait for "Create your first test" to appear
  click "Create your first test"
  wait for "Suite name" to appear
  type "Self test suite {{AXTEST_CASE}}" in "Suite name"
  type "First behaviour" in "Behaviour name"
  type "Projects" in "Element or label"
  click "Save"
  wait for "All changes saved" to appear
 ASSERT
  assert url contains "/editor"
  assert "Self test suite {{AXTEST_CASE}}" is_visible

TEST "Open account settings"
 ID self-settings
 STEPS
  navigate to "/settings"
  wait for "Current password" to appear
 ASSERT
  assert "Change password" is_visible
  assert "Confirm new password" is_visible
